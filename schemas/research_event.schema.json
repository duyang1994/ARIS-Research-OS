{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ARIS Research Event",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "source",
    "summary",
    "created_at"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "severity": {
      "type": "string"
    },
    "thread_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "result_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "requires_human_review": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string"
    }
  }
}